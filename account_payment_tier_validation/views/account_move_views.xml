<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_bks_payment_number" model="ir.ui.view">
        <field name="name">account.move.form.bks.payment.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1/field[@name='name']" position="after">
                <field
                    name="bks_draft_payment_name"
                    invisible="not bks_draft_payment_name"
                    readonly="1"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h1/span" position="attributes">
                <attribute
                    name="invisible"
                >name or name_placeholder or quick_edit_mode or bks_draft_payment_name</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_bks_payment_number" model="ir.ui.view">
        <field name="name">account.move.list.bks.payment.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="bks_draft_payment_name" column_invisible="True" />
            </field>
            <field name="name" position="attributes">
                <attribute
                    name="options"
                >{'placeholder_field': 'bks_draft_payment_name'}</attribute>
            </field>
        </field>
    </record>
</odoo>
