<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_bks_guarantee" model="ir.ui.view">
        <field name="name">account.payment.form.bks.guarantee</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_bks_guarantee_invoice"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="not bks_guarantee_move_id"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Facture</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
