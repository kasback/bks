<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bks_purchase_fnp_tree" model="ir.ui.view">
        <field name="name">bks.purchase.fnp.list</field>
        <field name="model">bks.purchase.fnp</field>
        <field name="arch" type="xml">
            <list string="Provisions FNP" create="0" delete="0">
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="amount"/>
                <field name="qty_reversed"/>
                <field name="amount_reversed"/>
                <field name="state"/>
                <field name="move_id"/>
                <field name="reversal_move_id"/>
                <field name="invoice_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_bks_purchase_fnp_form" model="ir.ui.view">
        <field name="name">bks.purchase.fnp.form</field>
        <field name="model">bks.purchase.fnp</field>
        <field name="arch" type="xml">
            <form string="Provision FNP" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="partner_id"/>
                            <field name="purchase_order_id"/>
                            <field name="picking_id"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="amount"/>
                            <field name="qty_reversed"/>
                            <field name="amount_reversed"/>
                            <field name="expense_account_id"/>
                            <field name="move_id"/>
                            <field name="reversal_move_id"/>
                            <field name="invoice_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bks_purchase_fnp" model="ir.actions.act_window">
        <field name="name">Provisions FNP achats</field>
        <field name="res_model">bks.purchase.fnp</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bks_purchase_fnp"
        name="Provisions FNP achats"
        parent="account.menu_finance_payables"
        action="action_bks_purchase_fnp"
        sequence="45"/>
</odoo>
