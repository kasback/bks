<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_bks_accounts" model="ir.ui.view">
        <field name="name">res.partner.form.bks.accounts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <field name="property_account_payable_id" position="attributes">
                <attribute name="string">Compte fournisseur</attribute>
            </field>
            <field name="property_account_payable_id" position="after">
                <field
                    name="property_account_advance_id"
                    options="{'no_create': True}"
                />
                <field
                    name="property_account_fnp_id"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>
</odoo>
