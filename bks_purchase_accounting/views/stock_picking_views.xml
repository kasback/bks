<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_bks_fnp" model="ir.ui.view">
        <field name="name">stock.picking.form.bks.fnp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_bks_generate_fnp"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-book"
                    string="Générer la FNP"
                    groups="account.group_account_invoice"
                    invisible="state != 'done' or picking_type_code != 'incoming' or not purchase_id or bks_fnp_count != 0"
                />
            </xpath>
        </field>
    </record>
</odoo>
