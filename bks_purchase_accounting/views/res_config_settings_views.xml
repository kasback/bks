<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bks_fnp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bks.fnp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">FNP achats (BKS)</span>
                        <div class="text-muted">
                            Compte et journal pour la provision à la réception et l'extourne à la facture fournisseur.
                        </div>
                        <div class="row mt16">
                            <label for="bks_fnp_account_id" class="col-lg-4 o_light_label"/>
                            <field name="bks_fnp_account_id" class="col-lg-8"/>
                        </div>
                        <div class="row">
                            <label for="bks_fnp_journal_id" class="col-lg-4 o_light_label"/>
                            <field name="bks_fnp_journal_id" class="col-lg-8"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_bks_guarantee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bks.guarantee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting
                    id="bks_guarantee_account"
                    string="Retenue de garantie"
                    company_dependent="1"
                    help="Compte unique lettrable crédité du TTC de la retenue. Le fournisseur reste sur la ligne pour le lettrage."
                >
                    <field name="bks_guarantee_account_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
