<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_bks_guarantee" model="ir.ui.view">
        <field name="name">account.move.form.bks.guarantee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_bks_guarantee_payments"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="bks_guarantee_payment_count == 0"
                >
                    <field
                        name="bks_guarantee_payment_count"
                        string="Retenue de garantie"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//header/button[@name='action_post'][last()]" position="after">
                <button
                    name="action_bks_pay_guarantee"
                    type="object"
                    string="Régler la garantie"
                    groups="account.group_account_invoice"
                    invisible="not bks_guarantee_to_pay"
                />
            </xpath>
            <xpath
                expr="//group[@id='header_right_group']/field[@name='date']"
                position="after"
            >
                <field name="bks_guarantee_to_pay" invisible="1" />
                <field
                    name="bks_guarantee_amount"
                    invisible="move_type != 'in_invoice'"
                    readonly="state != 'draft'"
                />
            </xpath>
        </field>
    </record>
</odoo>
