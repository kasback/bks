<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_bks_fnp" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.fnp</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                    name="action_view_bks_fnp"
                    class="oe_stat_button"
                    icon="fa-book"
                    invisible="bks_fnp_count == 0">
                    <field name="bks_fnp_count" widget="statinfo" string="FNP"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
