<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_bks_purchase_approval">
        <field name="name">Circuit validation achats</field>
        <field name="parent_id" ref="purchase_request.module_category_purchase_request" />
        <field name="sequence">20</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_bks_purchase_approval">
        <field name="name">Circuit validation achats</field>
        <field name="category_id" ref="module_category_bks_purchase_approval" />
        <field name="sequence">10</field>
    </record>

    <record id="group_ordonnateur" model="res.groups">
        <field name="name">Ordonnateur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[(4, ref('purchase_request.group_purchase_request_user'))]"
        />
        <field
            name="comment"
        >Établit et signe les demandes d'achat. Signe les BL / PV / CRA.</field>
    </record>

    <record id="group_coordonnateur" model="res.groups">
        <field name="name">Co-ordonnateur</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[
                (4, ref('purchase_request.group_purchase_request_manager')),
                (4, ref('purchase.group_purchase_user')),
            ]"
        />
        <field
            name="comment"
        >2e signature DA et 2e signature BDC. Co-valide les factures.</field>
    </record>

    <record id="group_acheteur" model="res.groups">
        <field name="name">Acheteur</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[(4, ref('purchase.group_purchase_user'))]"
        />
        <field name="comment">Établit les bons de commande.</field>
    </record>

    <record id="group_responsable_achats" model="res.groups">
        <field name="name">Responsable Achats</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[
                (4, ref('purchase.group_purchase_manager')),
                (4, ref('purchase_request.group_purchase_request_manager')),
            ]"
        />
        <field
            name="comment"
        >Valide les DA. 1re signature BDC. Co-valide les factures.</field>
    </record>

    <record id="group_directeur_pole" model="res.groups">
        <field name="name">Directeur du Pôle</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[(4, ref('purchase.group_purchase_user'))]"
        />
        <field
            name="comment"
        >3e signature BDC lorsque 40 KDH &lt; montant &lt;= 700 KDH.</field>
    </record>

    <record id="group_president" model="res.groups">
        <field name="name">Président</field>
        <field name="sequence">60</field>
        <field name="privilege_id" ref="res_groups_privilege_bks_purchase_approval" />
        <field
            name="implied_ids"
            eval="[(4, ref('purchase.group_purchase_user'))]"
        />
        <field name="comment">3e signature BDC lorsque montant &gt; 700 KDH.</field>
    </record>
</odoo>
