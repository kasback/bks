<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_acheteur_rule" model="ir.rule">
        <field name="name">Acheteur : DA approuvées ou en cours</field>
        <field name="model_id" ref="purchase_request.model_purchase_request" />
        <field name="groups" eval="[(4, ref('group_acheteur'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field
            name="domain_force"
        >[('state', 'in', ['approved', 'in_progress'])]</field>
    </record>
    <record id="purchase_request_line_acheteur_rule" model="ir.rule">
        <field name="name">Acheteur : lignes DA approuvées ou en cours</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line" />
        <field name="groups" eval="[(4, ref('group_acheteur'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field
            name="domain_force"
        >[('request_id.state', 'in', ['approved', 'in_progress'])]</field>
    </record>
</odoo>
