<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_bks_withholding" model="ir.ui.view">
        <field name="name">product.template.form.bks.withholding</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="rmg_l10n_ma_withholding.product_template_form_view" />
        <field name="arch" type="xml">
            <field name="rmg_withholding_service_nature" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="rmg_withholding_goods_nature" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="rmg_withholding_service_nature" position="before">
                <field
                    name="bks_withholding_nature"
                    widget="radio"
                    invisible="'MA' not in (fiscal_country_codes or '')"
                />
            </field>
        </field>
    </record>
</odoo>
