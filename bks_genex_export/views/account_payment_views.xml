<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_tree_genex" model="ir.ui.view">
        <field name="name">account.payment.list.genex</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field
                    name="genex_exported"
                    string="Est exporté GENEX"
                    widget="boolean"
                    optional="show"
                />
            </field>
        </field>
    </record>

    <record id="view_account_payment_form_genex" model="ir.ui.view">
        <field name="name">account.payment.form.genex</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_validate']" position="after">
                <field name="bks_show_payment_order_button" invisible="1" />
                <button
                    name="action_bks_print_payment_order"
                    string="Ordre de paiement"
                    type="object"
                    class="btn-secondary"
                    invisible="not bks_show_payment_order_button"
                    confirm="Le téléchargement de l'ordre de paiement est unique : le fichier est enregistré sur le serveur et ce bouton disparaîtra ensuite. En cas de perte du fichier, contactez la comptabilité. Voulez-vous continuer ?"
                />
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field
                    name="bks_payment_order_generated"
                    string="Ordre de paiement généré"
                    readonly="1"
                    widget="boolean"
                    groups="base.group_system"
                />
                <field
                    name="bks_payment_order_generated_at"
                    readonly="1"
                    invisible="not bks_payment_order_generated"
                    groups="base.group_system"
                />
                <field
                    name="bks_payment_order_attachment_id"
                    readonly="1"
                    invisible="not bks_payment_order_generated"
                    groups="base.group_system"
                />
                <field
                    name="genex_exported"
                    string="Est exporté GENEX"
                    readonly="1"
                    widget="boolean"
                />
                <field
                    name="genex_export_date"
                    readonly="1"
                    invisible="not genex_exported"
                />
                <field
                    name="genex_export_user_id"
                    readonly="1"
                    invisible="not genex_exported"
                />
            </xpath>
        </field>
    </record>

    <record id="action_account_payment_genex_export" model="ir.actions.server">
        <field name="name">Export GENEX</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_genex_export_wizard()</field>
    </record>
</odoo>
