<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_genex" model="ir.ui.view">
        <field name="name">account.payment.form.genex</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_validate']" position="before">
                <field name="bks_show_genex_export_button" invisible="1" />
                <field name="genex_exported" invisible="1" />
                <button
                    name="action_open_genex_export_wizard"
                    string="Exporter GENEX"
                    type="object"
                    class="btn-secondary"
                    invisible="not bks_show_genex_export_button"
                />
            </xpath>
        </field>
    </record>

    <record id="action_account_payment_genex_export" model="ir.actions.server">
        <field name="name">Export GENEX</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field name="binding_model_id" ref="account.model_account_payment" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_genex_export_wizard()</field>
    </record>
</odoo>
