<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_account_move_genex_export" model="ir.actions.act_window">
        <field name="name">Export GENEX</field>
        <field name="res_model">bks.genex.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="binding_view_types">list,form</field>
    </record>

    <menuitem
        id="menu_bks_genex_export"
        name="Export GENEX"
        parent="account.menu_finance_reports"
        action="action_bks_genex_export_wizard"
        sequence="95"
        groups="account.group_account_user"
    />

    <record id="view_account_move_filter_genex" model="ir.ui.view">
        <field name="name">account.move.search.genex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <filter name="posted" position="after">
                <separator />
                <filter
                    name="genex_not_exported"
                    string="Non exportées GENEX"
                    domain="[('genex_exported', '=', False)]"
                />
                <filter
                    name="genex_exported"
                    string="Exportées GENEX"
                    domain="[('genex_exported', '=', True)]"
                />
            </filter>
        </field>
    </record>

    <record id="view_move_form_genex" model="ir.ui.view">
        <field name="name">account.move.form.genex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_reset_to_draft_button']" position="after">
                <field name="genex_exported" invisible="1" />
                <label
                    for="genex_export_date"
                    invisible="not genex_exported"
                    string="Export GENEX"
                />
                <div invisible="not genex_exported" class="o_row">
                    <field name="genex_export_date" readonly="1" />
                    <field name="genex_export_user_id" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_tree_genex" model="ir.ui.view">
        <field name="name">account.move.list.genex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="genex_exported"
                    string="GENEX"
                    widget="boolean"
                    optional="hide"
                />
            </field>
        </field>
    </record>
</odoo>
