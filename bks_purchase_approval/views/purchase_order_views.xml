<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_bks_bc_ui" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.bc.ui</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_stock.purchase_order_view_form_inherit"
        />
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <field name="picking_type_id" position="attributes">
                <attribute
                    name="groups"
                >bks_purchase_approval.group_bks_bc_extra_fields</attribute>
            </field>
            <field name="dest_address_id" position="attributes">
                <attribute
                    name="groups"
                >bks_purchase_approval.group_bks_bc_extra_fields</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_order_form_bks_sale_purchase_readonly" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.sale.purchase.readonly</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_stock.purchase_order_view_form_inherit"
        />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <field name="dest_address_id" position="attributes">
                <attribute name="readonly">locked or bks_has_sale_order</attribute>
            </field>
        </field>
    </record>

    <record id="purchase_order_form_bks_send_email_access" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.send.email.access</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="bks_has_sale_order" invisible="1" />
                <field name="bks_can_send_ddp" invisible="1" />
                <field name="bks_can_send_bdc_email" invisible="1" />
            </field>
            <xpath
                expr="//header/button[@name='action_rfq_send'][@invisible=&quot;state != 'draft'&quot;]"
                position="attributes"
            >
                <attribute name="groups" />
                <attribute
                    name="invisible"
                >state != 'draft' or not bks_can_send_ddp</attribute>
            </xpath>
            <xpath
                expr="//header/button[@name='action_rfq_send'][@invisible=&quot;state != 'sent'&quot;]"
                position="attributes"
            >
                <attribute name="groups" />
                <attribute
                    name="invisible"
                >state != 'sent' or not bks_can_send_ddp</attribute>
            </xpath>
            <xpath
                expr="//header/button[@name='action_rfq_send'][@invisible=&quot;state != 'purchase'&quot;]"
                position="attributes"
            >
                <attribute name="groups" />
                <attribute
                    name="invisible"
                >state != 'purchase' or not bks_can_send_bdc_email</attribute>
            </xpath>
            <xpath
                expr="//header/button[@name='%(purchase.action_report_purchase_order)d']"
                position="attributes"
            >
                <attribute
                    name="name"
                >%(bks_purchase_approval.action_report_purchase_order_bks)d</attribute>
                <attribute name="string">Imprimer</attribute>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_bks_hide_upload_bill" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.hide.upload.bill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <widget name="purchase_file_uploader" position="attributes">
                <attribute name="invisible">1</attribute>
            </widget>
        </field>
    </record>
    <record id="purchase_order_form_bks_vendor_bill" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.vendor.bill</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="bks_can_create_vendor_bill" invisible="1" />
            </field>
        </field>
    </record>
    <record id="purchase_order_form_bks_vendor_bill_down_payment" model="ir.ui.view">
        <field name="name">purchase.order.form.bks.vendor.bill.down.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_down_payment.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(purchase_down_payment.purchase_order_advance_payment_action)d']"
                position="attributes"
            >
                <attribute
                    name="invisible"
                >state != 'purchase' or not bks_can_create_vendor_bill</attribute>
            </xpath>
        </field>
    </record>
</odoo>
