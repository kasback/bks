<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_bks_vendor_locked" model="ir.ui.view">
        <field name="name">account.move.form.bks.vendor.locked</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_id" widget="res_partner_many2one" position="before">
                <field name="bks_vendor_locked_from_po" invisible="1" />
                <field name="bks_operation_department_id" invisible="1" />
            </field>
            <xpath
                expr="//group[@id='header_right_group']/field[@name='date']"
                position="after"
            >
                <field
                    name="bks_invoice_reception_date"
                    invisible="move_type != 'in_invoice'"
                    required="move_type == 'in_invoice' and state == 'draft'"
                    readonly="state != 'draft'"
                />
            </xpath>
            <field name="partner_id" widget="res_partner_many2one" position="attributes">
                <attribute
                    name="readonly"
                >state != 'draft' or bks_vendor_locked_from_po</attribute>
                <attribute name="domain">[
                    '&amp;',
                        '|', ('company_id', '=', False), ('company_id', 'parent_of', company_id),
                        '|', ('supplier_rank', '&gt;', 0), ('customer_rank', '&gt;', 0)
                ]</attribute>
                <attribute name="context">{
                    'res_partner_search_mode': (move_type in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or (move_type in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or False,
                    'search_default_supplier': move_type in ('in_invoice', 'in_refund', 'in_receipt') and 1 or 0,
                    'search_default_customer': move_type in ('out_invoice', 'out_refund', 'out_receipt') and 1 or 0,
                    'show_address': 1,
                    'default_is_company': True,
                    'show_vat': True
                }</attribute>
            </field>
        </field>
    </record>

    <record id="view_move_form_bks_finance_move_actions" model="ir.ui.view">
        <field name="name">account.move.form.bks.finance.move.actions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="show_reset_to_draft_button" position="after">
                <field name="bks_user_can_finance_move_actions" invisible="1" />
            </field>
            <button name="action_reverse" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="invisible"
                >move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or not bks_user_can_finance_move_actions</attribute>
            </button>
            <button name="button_draft" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="invisible"
                >not show_reset_to_draft_button or not bks_user_can_finance_move_actions</attribute>
            </button>
        </field>
    </record>
</odoo>
