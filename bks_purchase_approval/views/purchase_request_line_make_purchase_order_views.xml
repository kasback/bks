<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_purchase_request_line_make_purchase_order_bks_rfq_domain"
        model="ir.ui.view"
    >
        <field name="name">purchase.request.line.make.purchase.order.bks.rfq</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_request.view_purchase_request_line_make_purchase_order"
        />
        <field name="arch" type="xml">
            <field name="purchase_order_id" position="attributes">
                <attribute
                    name="domain"
                >[('partner_id', '=', supplier_id), ('state', 'in', ('draft', 'sent'))]</attribute>
            </field>
        </field>
    </record>
</odoo>
