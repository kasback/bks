<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="paperformat_bks_purchase_order" model="report.paperformat">
        <field name="name">BKS Bon de commande</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_purchase_order_bks" model="ir.actions.report">
        <field name="name">Bon de commande BKS</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bks_purchase_approval.report_purchaseorder_bks</field>
        <field name="report_file">bks_purchase_approval.report_purchaseorder_bks</field>
        <field name="print_report_name">'Bon de commande BKS - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_bks_purchase_order" />
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_purchase_order_bks_xlsx" model="ir.actions.report">
        <field name="name">Bon de commande BKS (Excel)</field>
        <field name="model">purchase.order</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">bks_purchase_approval.report_purchase_order_xlsx</field>
        <field name="report_file">bks_purchase_approval.report_purchase_order_xlsx</field>
        <field name="print_report_name">'Bon de commande BKS - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="binding_type">report</field>
    </record>

    <record id="purchase.email_template_edi_purchase_done" model="mail.template">
        <field
            name="report_template_ids"
            eval="[(6, 0, [ref('bks_purchase_approval.action_report_purchase_order_bks')])]"
        />
    </record>
    <record id="purchase.email_template_edi_purchase_reminder" model="mail.template">
        <field
            name="report_template_ids"
            eval="[(6, 0, [ref('bks_purchase_approval.action_report_purchase_order_bks')])]"
        />
    </record>
</odoo>
